
# ==========================================
# STEAL AN EGG SAAS — BACKEND CONFIGURATION
# ==========================================

# Server
NODE_ENV=production
PORT=3000

# MySQL Database — ITDB Cloud
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# Dashboard JWT Authentication
# Replace with a randomly generated secret (64+ characters recommended)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_TTL=3600

# User Login Session (30 minutes)
USER_SESSION_TTL=1800

# Discord Bot Authentication
# Use the SAME secret in backend and bot environment
BOT_INGEST_KEY=REPLACE_WITH_A_RANDOM_BOT_SECRET

# Admin Account
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# OBS Overlay Authentication
OVERLAY_TOKEN=REPLACE_WITH_A_RANDOM_OVERLAY_TOKEN

# CORS — Replace with your actual frontend domain
# Example: https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com

# Rate Limits
KEY_GEN_RATE_LIMIT=5
INGEST_RATE_LIMIT_PER_MIN=120

# Default Stock Expiry
DEFAULT_TIER_TTL_MINUTES=45
