
# Server
PORT=3000
NODE_ENV=production

# MySQL / ITDB Cloud
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# Authentication — replace placeholders with strong random secrets
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_TTL=3600
USER_SESSION_TTL=1800

# Discord bot -> backend authentication
BOT_INGEST_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Admin login
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# OBS overlay authentication
OVERLAY_TOKEN=REPLACE_WITH_A_RANDOM_OVERLAY_TOKEN

# Browser access
ALLOWED_ORIGIN=https://YOUR-BACKEND-DOMAIN.example

# Rate limits
KEY_GEN_RATE_LIMIT=5
INGEST_RATE_LIMIT_PER_MIN=120

# Stock expiration
DEFAULT_TIER_TTL_MINUTES=45
